#!/bin/bash
# Xray Patched CLI - https://github.com/ARIFxVOID/xray-patched
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPORT_DIR="$SCRIPT_DIR/reports"

XRAY="$HOME/.xray-patched"
if [ ! -x "$XRAY" ]; then
  cp "$SCRIPT_DIR/xray-patched" "$XRAY" 2>/dev/null
  chmod +x "$XRAY" 2>/dev/null
fi
[ -x "$XRAY" ] || { echo "Xray binary not found at $XRAY"; exit 1; }

mkdir -p "$REPORT_DIR"

# Auto-generate xray.yaml / module.xray.yaml / plugin.xray.yaml if missing
ensure_configs() {
  [ -f "$SCRIPT_DIR/xray.yaml" ] && return
  cat > "$SCRIPT_DIR/xray.yaml" << 'EOF'
- description: All plugins
  disabled_plugins: []
  enabled_plugins:
  - printer
  - service-scan
  - target-parser
  - vuln-scan
  module_config: module.xray.yaml
  name: x
  plugin_config: plugin.xray.yaml
  plugin_path:
  - ./plugin
EOF
  cat > "$SCRIPT_DIR/module.xray.yaml" << 'EOF'
Client:
  allow_methods:
  - HEAD
  - GET
  - POST
  - PUT
  - PATCH
  - DELETE
  - OPTIONS
  - CONNECT
  - TRACE
  dial_timeout: 5
  enable_http2: false
  fail_retries: 0
  headers: {}
  max_conns_per_host: 50
  max_qps: 500
  max_redirect: 5
  max_resp_body_size: 2.097152e+06
  passive_mode: false
  pkcs12:
    Password: ""
    Path: ""
  proxy: ""
  proxy_rule: null
  read_timeout: 10
Pool:
  size: 100
Reverse:
  client:
    dns_server_ip: ""
    http_base_url: ""
    remote_server: false
    reverse_api: ""
    reverse_server_url: ""
    rmi_server_addr: ""
  db_file_path: ""
  dns:
    domain: ""
    enabled: false
    is_domain_name_server: false
    listen_ip: 0.0.0.0
    resolve:
    - record: localhost
      ttl: 60
      type: A
      value: 127.0.0.1
  http:
    enabled: false
    ip_header: ""
    listen_ip: 0.0.0.0
    listen_port: ""
  rmi:
    enabled: false
    listen_ip: 127.0.0.1
    listen_port: ""
  token: ""
EOF
  cat > "$SCRIPT_DIR/plugin.xray.yaml" << 'EOF'
printer:
  disable_host_print: false
  disable_port_print: false
  disable_service_print: false
  disable_website_print: false
service-scan:
  bandwidth: 1000
  flag:
    bandwidth: bandwidth,bw
    max_service_per_host: max-srv,ms
    port: port,p
    skip_fingerprint: skip-fingerprint,sf
    skip_live: skip-live,sl
    skip_syn: skip-syn,ss
    skip_web_fingerprint: skip-web,sw
    timeout: timeout
  max_service_per_host: 0
  port: 22,80,443
  skip_fingerprint: false
  skip_live: false
  skip_syn: false
  skip_web_fingerprint: false
  timeout: 2
target-parser:
  flag:
    target: target,t
  group_size: 256
  target: ""
vuln-scan:
  config_file: config.yaml
  flag:
    config_file: config
    html_output: html-output,ho
    json_output: json_output,jo
    level: level
    log_level: log-level
    plugins: plugins
    poc: poc
    stdout: stdout
    tags: tags
    text_output: text-output,to
    webhook_output: webhook-output,wo
  html_output: ""
  json_output: ""
  level: ""
  log_level: ""
  plugins: ""
  poc: ""
  stdout: true
  tags: ""
  text_output: ""
  webhook_output: ""
EOF
}
ensure_configs

show_help() {
  echo "Xray Patched CLI - Usage:"
  echo "  xray webscan <url>              Scan website"
  echo "  xray servicescan <host:port>    Scan service/port"
  echo "  xray subdomain <domain>         Scan subdomain"
  echo "  xray fullscan <url>             Scan semua plugin"
  echo "  xray poclint <pattern>          Validasi POC"
  echo "  xray webui                      Dashboard browser"
  echo "  xray tools cve <CVE-ID>         CVE lookup + searchsploit"
  echo "  xray tools searchsploit <q>     Search exploit-db"
  echo "  xray tools diff                 Diff scan results"
  echo "  xray tools exploit <url>        Auto exploit target"
  echo "  xray tools interactsh           Setup interact.sh"
  echo "  xray reverse                    Start reverse server"
  echo "  xray genca                      Generate CA"
  echo "  xray version                    Tampilkan versi"
  echo "  xray schedule <url> [int] [cnt] Scan berulang"
  echo "  xray massal <file>              Scan dari file list"
  echo "  xray menu                       Mode interaktif"
  echo "  xray help                       Ini"
}

case "${1:-menu}" in
  webscan)
    url="${2:-}"
    [ -z "$url" ] && { echo "Usage: xray webscan <url>"; exit 1; }
    ts=$(date +%Y%m%d-%H%M%S)
    out="$REPORT_DIR/webscan-$ts.html"
    cd "$SCRIPT_DIR" && $XRAY webscan --url "$url" --html-output "$out"
    echo "Report: $out"
    ;;
  servicescan)
    target="${2:-}"
    module="${3:-weblogic}"
    [ -z "$target" ] && { echo "Usage: xray servicescan <host:port> [module]"; exit 1; }
    cd "$SCRIPT_DIR" && $XRAY servicescan --target "$target" --module "$module"
    ;;
  subdomain)
    domain="${2:-}"
    [ -z "$domain" ] && { echo "Usage: xray subdomain <domain>"; exit 1; }
    ts=$(date +%Y%m%d-%H%M%S)
    out="$REPORT_DIR/subdomain-$ts.html"
    cd "$SCRIPT_DIR" && $XRAY subdomain --target "$domain" --html-output "$out"
    echo "Report: $out"
    ;;
  fullscan)
    url="${2:-}"
    [ -z "$url" ] && { echo "Usage: xray fullscan <url>"; exit 1; }
    ts=$(date +%Y%m%d-%H%M%S)
    out="$REPORT_DIR/fullscan-$ts.html"
    cd "$SCRIPT_DIR" && $XRAY x --url "$url" --html-output "$out"
    echo "Report: $out"
    ;;
  poclint)
    pattern="${2:-}"
    [ -z "$pattern" ] && pattern="$SCRIPT_DIR/poc/*.yaml"
    cd "$SCRIPT_DIR" && $XRAY poclint --script "$pattern"
    ;;
  webui)
    python3 "$SCRIPT_DIR/xray-webui"
    ;;
  tools)
    shift
    bash "$SCRIPT_DIR/xray-tools" "$@"
    ;;
  reverse)
    cd "$SCRIPT_DIR" && $XRAY reverse
    ;;
  genca)
    cd "$SCRIPT_DIR" && $XRAY genca
    echo "CA: $SCRIPT_DIR/ca.crt"
    ;;
  version)
    cd "$SCRIPT_DIR" && $XRAY version
    ;;
  schedule)
    url="${2:-}"
    interval="${3:-3600}"
    count="${4:-0}"
    [ -z "$url" ] && { echo "Usage: xray schedule <url> [interval] [count]"; exit 1; }
    c=0
    while true; do
      [ "$count" -gt 0 ] && [ "$c" -ge "$count" ] && break
      c=$((c+1))
      ts=$(date +%Y%m%d-%H%M%S)
      out="$REPORT_DIR/schedule-${c}-$ts.html"
      echo "[$c] $(date) Scanning $url"
      cd "$SCRIPT_DIR" && $XRAY webscan --url "$url" --html-output "$out" 2>/dev/null
      [ "$count" -le 0 ] || [ "$c" -lt "$count" ] && sleep "$interval"
    done
    echo "Schedule done"
    ;;
  massal)
    file="${2:-}"
    [ -z "$file" ] && { echo "Usage: xray massal <file>"; exit 1; }
    [ ! -f "$file" ] && { echo "File not found: $file"; exit 1; }
    total=$(wc -l < "$file")
    i=0
    while IFS= read -r url; do
      [ -z "$url" ] && continue
      i=$((i+1))
      ts=$(date +%Y%m%d-%H%M%S)
      safe=$(echo "$url" | sed 's|https\?://||;s|[/:]|_|g')
      out="$REPORT_DIR/massal-${i}-${safe}-$ts.html"
      echo "[$i/$total] $url"
      cd "$SCRIPT_DIR" && $XRAY webscan --url "$url" --html-output "$out" 2>/dev/null
    done < "$file"
    echo "Done: $i targets"
    ;;
  menu|"")
    bash "$SCRIPT_DIR/xray-menu.sh"
    ;;
  help|--help|-h)
    show_help
    ;;
  *)
    echo "Unknown: $1"
    show_help
    exit 1
    ;;
esac
