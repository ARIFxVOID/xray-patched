class DashboardHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path == "/" or parsed.path == "/index.html":
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(self.render_dashboard().encode())
        elif parsed.path.startswith("/reports/"):
            fname = os.path.basename(parsed.path)
            fpath = os.path.join(REPORT_DIR, fname)
            if os.path.isfile(fpath):
                self.send_response(200)
                self.send_header("Content-Type", "text/html" if fname.endswith(".html") else "text/plain")
                self.end_headers()
                with open(fpath, "rb") as f: self.wfile.write(f.read())
            else: self.send_error(404)
        elif parsed.path == "/api/reports":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(self.scan_reports()).encode())
        else: self.send_error(404)

    def scan_reports(self):
        reports = []
        if not os.path.isdir(REPORT_DIR): return reports
        for f in sorted(os.listdir(REPORT_DIR), reverse=True):
            if not f.endswith(".html") or f == "summary-index.html": continue
            fpath = os.path.join(REPORT_DIR, f)
            try: size = os.path.getsize(fpath)
            except: size = 0
            mtime = datetime.fromtimestamp(os.path.getmtime(fpath))
            parts = f.replace(".html", "").split("-")
            rtype = parts[0] if len(parts) > 0 else "unknown"
            target = "-".join(parts[1:-1]) if len(parts) > 1 else "unknown"
            reports.append({"file": f, "type": rtype, "target": target, "size": size, "time": mtime.isoformat()})
        return reports

    def render_dashboard(self):
        reports = self.scan_reports()
        total = len(reports)
        today = sum(1 for r in reports if r["time"].startswith(datetime.now().strftime("%Y-%m-%d")))
        vuln_count = 0
        for r in reports:
            fpath = os.path.join(REPORT_DIR, r["file"])
            try:
                with open(fpath, "rb") as fh:
                    raw = fh.read(1048576)  # first 1MB
                vuln_count += raw.count(b"vuln-")
                vuln_count += raw.count(b"class=\"vuln\"")
                vuln_count += raw.count(b"class=\"danger\"")
                vuln_count += raw.count(b"severity")
            except:
                pass
        from datetime import timedelta
        cutoff = (datetime.now() - timedelta(hours=24)).isoformat()
        new_count = sum(1 for r in reports if r["time"] > cutoff)
        last_scan = reports[0]["time"] if reports else "N/A"
        rows = ""
        for i, r in enumerate(reports):
            idx = total - i
            stype = r["type"]
            rows += f'<tr data-type="{stype}">'
            rows += f'<td>{idx}</td>'
            rows += f'<td><a href="/reports/{r["file"]}">{r["file"]}</a></td>'
            rows += f'<td><span class="tag">{stype}</span></td>'
            rows += f'<td>{r["target"][:50]}</td>'
            rows += f'<td>{r["size"]//1024}KB</td>'
            rows += f'<td>{r["time"][:19].replace("T"," ")}</td>'
            rows += "</tr>"
        return HTML_TEMPLATE.format(total=total, today=today, vuln_count=vuln_count,
                                     new_count=new_count, last_scan=last_scan[:19].replace("T"," "),
                                     rows=rows)

if __name__ == "__main__":
    print(f"[+] Xray Web UI: http://0.0.0.0:{PORT}")
